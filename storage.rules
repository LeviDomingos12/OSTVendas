rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 1. Strict Tenant Isolated Backups & Assets: /admins/{tenantUid}/...
    match /admins/{tenantUid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == tenantUid;
    }

    // 2. Strict User Personal Assets (avatars, receipts): /users/{userId}/...
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. User UID root uploads: /{userId}/...
    match /{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 4. Default Deny: All unauthenticated or cross-tenant access is blocked
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
