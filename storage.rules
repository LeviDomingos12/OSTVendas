rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions for security validation
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isUserSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isTenantOwner(tenantUid) {
      return isAuthenticated() && request.auth.uid == tenantUid;
    }

    // 1. Strict User-prefixed uploads: /{userId}/...
    // Only the authenticated user whose UID matches the top-level path segment can read or write
    match /{userId}/{allPaths=**} {
      allow read, write: if isUserSelf(userId);
    }

    // 2. Strict Users namespace: /users/{userId}/...
    // Only the authenticated user can access their personal assets, receipts, and avatars
    match /users/{userId}/{allPaths=**} {
      allow read, write: if isUserSelf(userId);
    }

    // 3. Strict Admin/Tenant namespace: /admins/{tenantUid}/...
    // Only the authenticated tenant matching tenantUid can access tenant backups and shared store assets
    match /admins/{tenantUid}/{allPaths=**} {
      allow read, write: if isTenantOwner(tenantUid);
    }

    // 4. Default Deny: All unauthenticated or cross-account file access is strictly blocked
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
