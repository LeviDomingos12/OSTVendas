rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security validation
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isTenantOwner(tenantUid) {
      return isAuthenticated() && request.auth.uid == tenantUid;
    }

    function isUserSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Strict Tenant Subtree Partitioning: /admins/{tenantUid}/...
    // Only the authenticated tenant (matching request.auth.uid) can access their collections
    // (produtos, customers, transacoes, cashflow, employees, settings, logs, solicitacoes_recuperacao)
    match /admins/{tenantUid}/{document=**} {
      allow read, write: if isTenantOwner(tenantUid);
    }

    // 2. Strict User Subtree: /users/{userId}/...
    match /users/{userId}/{document=**} {
      allow read, write: if isUserSelf(userId);
    }

    // 3. User Profiles: /usuarios/{userId}
    // Users can only read and write their own personal profile
    match /usuarios/{userId} {
      allow read, write: if isUserSelf(userId);
    }

    // 4. Default Deny: All unauthenticated, global, or cross-tenant access is strictly blocked (403 Permission Denied)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

