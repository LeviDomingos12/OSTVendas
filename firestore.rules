rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Dynamic, segmented access rule: any collection segmented by user's UID or tenant key (multi-tenant partition)
    match /admins/{uid}/{document=**} {
      allow read, write: if true;
    }

    // Root-level usuarios collection for employee profiles and sync
    match /usuarios/{userId} {
      allow read, write: if true;
    }

    // Publicly readable/writable configuration rules
    match /configuracoes/{configId} {
      allow read, write: if true;
    }
  }
}

