rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Multi-tenant partitioned paths under /admins/{tenantUid}/{collectionName}/{documentId}
    match /admins/{tenantUid}/{collectionName}/{documentId} {
      allow read, write: if true;
    }

    // Tenant subtree fallback
    match /admins/{tenantUid}/{document=**} {
      allow read, write: if true;
    }

    // Root-level user profiles and team members
    match /usuarios/{userId} {
      allow read, write: if true;
    }

    match /employees/{employeeId} {
      allow read, write: if true;
    }

    // Operational collections (products, customers, transactions, cashflow, etc.)
    match /{collectionName}/{docId} {
      allow read, write: if true;
    }

    // Application settings
    match /settings/{configId} {
      allow read, write: if true;
    }

    match /configuracoes/{configId} {
      allow read, write: if true;
    }

    // Immutable audit logs
    match /auditlogs/{logId} {
      allow read, write: if true;
    }

    match /logs/{logId} {
      allow read, write: if true;
    }
  }
}
